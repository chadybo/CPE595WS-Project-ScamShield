<form action="/predict" method="POST">
  <label for="subject">Enter email subject:</label>
  <textarea
    id="subject"
    name="subject"
    placeholder="Paste the subject here"
    rows="8"
    required
  ></textarea>

  <label for="content">Enter email content:</label>
  <textarea
    id="content"
    name="content"
    placeholder="Paste the email content here"
    rows="8"
    required
  ></textarea>

  <button type="submit">Analyze Message</button>

</form>